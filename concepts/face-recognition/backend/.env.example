# Copy this file to backend/.env and adjust. Real environment variables
# override anything set here.

# PostgreSQL + pgvector (the only storage backend). This DSN matches the
# database in docker-compose.yml — start it with: docker compose up -d db
DATABASE_URL=postgresql://face:face@localhost:5433/facedb

# insightface model pack: buffalo_s (fast, CPU-friendly) or buffalo_l (more accurate)
#FACE_MODEL=buffalo_s

# Cosine similarity cutoff for a positive match — tune with real photos
#SIMILARITY_THRESHOLD=0.40

# CORS: comma-separated origins, or *
#ALLOWED_ORIGINS=*

# kg this station had gathered before it started recording sessions here.
# Defaults to 0: the summary shows only what was actually weighed. Set it only
# to a figure the station can stand behind.
#COMMUNITY_BASE_KG=0
#COMMUNITY_GOAL_KG=15000
